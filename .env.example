# Pegue esses dois valores em: painel do Supabase > Project Settings > API Keys
# A publishable key é pública por design (o navegador precisa dela) — a
# segurança real vem do RLS. Veja docs/SECURITY.md.
# Nunca coloque a "secret key" aqui — essa nunca pode ir pro front-end.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta do Supabase (Project Settings > API Keys > Secret keys).
# Só servidor, nunca com NEXT_PUBLIC_. Usada apenas em tarefas de admin (criar contas).
SUPABASE_SECRET_KEY=

# Caminho secreto do painel admin (sem barra). Gere um valor aleatório longo.
ADMIN_PATH=

# Sal para hash de IP no rate limit (só servidor). Valor aleatório longo.
RATE_LIMIT_SALT=

# Endereço público do site, sem barra no fim (ex.: https://abaconsultorias.com.br).
# Usado em metadados, sitemap e robots. Na Vercel, o valor de produção.
NEXT_PUBLIC_SITE_URL=

# Segredo da tarefa agendada que limpa arquivos órfãos (só servidor). Valor
# aleatório longo; a Vercel envia como "Authorization: Bearer <valor>".
CRON_SECRET=

# Aviso por e-mail de cada contato recebido pelo site (Resend, só servidor).
# Sem RESEND_API_KEY ou EMAIL_REMETENTE o site funciona normalmente, sem enviar e-mail.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend (ex.: ABA Consultoria <site@abaconsultorias.com.br>).
EMAIL_REMETENTE=
# Quem recebe o aviso. Se vazio, usa o e-mail das configurações do site.
AVISO_CONTATO_PARA=

# Conexão direta com o banco, só para o backup local (scripts/backup.mjs).
# Painel do Supabase > Connect > string de conexão (Session pooler), com a senha do banco
# (caracteres especiais da senha em código: @ vira %40).
# Nunca na Vercel e nunca com NEXT_PUBLIC_.
SUPABASE_DB_URL=

# Pasta onde o backup é guardado, fora do repositório. Opcional; se vazio,
# usa ../backups-aba (ao lado da pasta do projeto).
BACKUP_DIR=

# Cloudflare R2 (Etapa 7) - nunca com NEXT_PUBLIC_
R2_ACCOUNT_ID=
R2_BUCKET_DOCUMENTOS=aba-portal-documentos-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Espelho dos PDFs do R2 no backup (scripts/backup.mjs). Só no PC do backup, nunca na Vercel.
# Crie no Cloudflare uma chave de API do R2 SÓ DE LEITURA (Object Read only) restrita ao balde
# de produção e preencha as quatro variáveis abaixo. Se ficarem todas vazias, o backup usa as
# variáveis R2_* acima; se não houver nenhuma, o espelho é pulado com aviso.
# R2_BACKUP_ACCOUNT_ID=
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=
# R2_BACKUP_BUCKET=
